[Unit]
Description=FastAPI Dictionary Server
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/Server_FastAPI
EnvironmentFile=/opt/Server_FastAPI/.env
ExecStart=/opt/Server_FastAPI/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
